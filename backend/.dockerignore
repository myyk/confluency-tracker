# The host's virtualenv must never reach the image: it is built for the host's
# platform, and the image builds its own at /opt/venv.
.venv/
venv/

__pycache__/
*.py[cod]

# The SQLite path is the non-Docker one; a stray copy would only confuse.
*.sqlite3
*.sqlite3-journal

.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

.env
.env.*
!.env.example

.git/
.gitignore
Dockerfile
.dockerignore
